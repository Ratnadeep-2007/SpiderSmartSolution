# App Settings
PROJECT_NAME="SpiderSmart IMS"

# Security
SECRET_KEY="your-super-secret-key-here"
ALGORITHM="HS256"

# Database
# For Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/spidersmart_ims"

# CORS
ALLOWED_ORIGINS=["http://localhost:5173"]

# Email (Optional for Phase 1 start)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"

# Background Scheduler (disable on cPanel, enable locally)
RUN_SCHEDULER=true
